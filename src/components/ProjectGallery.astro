---
import WebGLImage from "./WebGLImage/WebGLImage.astro";
import WebGLVideo from "./WebGLImage/WebGLVideo.astro";
import ProjectGalleryControls from "./ProjectGalleryControls.tsx";
import MouseOver from "../components/MouseOver.astro";

interface Props {
    id: string;
    ratio: string | null;
    images: Array<{
        type: "img" | "vid";
        fit?: boolean;
        src: string;
        alt: string;
    }>;
}

const { id, ratio, images } = Astro.props;
---

<div class="w-full relative gallery-wrapper" data-gallery-id={id}>
    <script>
        import barba from "@barba/core";

        const setupHover = () => {
            const wrappers = document.querySelectorAll(".gallery-wrapper");

            wrappers.forEach((wrapper) => {
                const galleryId = wrapper.getAttribute("data-gallery-id");

                const carousel = wrapper.querySelector(
                    `#${galleryId}-carousel`,
                );
                const prev = document.querySelector(`.${galleryId}-prev-hover`);
                const next = document.querySelector(`.${galleryId}-next-hover`);

                if (!carousel || !prev || !next) return;

                carousel.addEventListener("scroll", () => {
                    updateControls();
                });

                const handlePrevClick = () => {
                    carousel.scrollBy({
                        left: -carousel.clientWidth,
                        behavior: "smooth",
                    });
                };

                const handleNextClick = () => {
                    carousel.scrollBy({
                        left: carousel.clientWidth,
                        behavior: "smooth",
                    });
                };

                prev.addEventListener("click", handlePrevClick);
                next.addEventListener("click", handleNextClick);

                const hide = (el) => {
                    el.classList.add("opacity-0", "pointer-events-none");
                    el.classList.remove("opacity-100", "pointer-events-auto");
                };

                const show = (el) => {
                    el.classList.remove("opacity-0", "pointer-events-none");
                    el.classList.add("opacity-100", "pointer-events-auto");
                };

                const updateControls = () => {
                    const scrollLeft = carousel.scrollLeft;
                    const maxScrollLeft =
                        carousel.scrollWidth - carousel.clientWidth;

                    if (scrollLeft <= 0) {
                        hide(prev);
                    } else {
                        show(prev);
                    }
                    if (scrollLeft >= maxScrollLeft - 1) {
                        hide(next);
                    } else {
                        show(next);
                    }
                };

                updateControls();
            });
        };

        barba.hooks.beforeEnter(() => {
            setupHover();
        });
        window.addEventListener("DOMContentLoaded", setupHover);
    </script>
    <div
        style={ratio ? `aspect-ratio: ${ratio}` : null}
        id={id}
        class="w-full relative"
    >
        <div
            class={`absolute top-0 left-0 h-5/6 w-1/3 z-10 hover-tooltip ${id}-prev-hover opacity-100 pointer-events-auto`}
            data-hover-text="Previous"
        >
        </div>
        <div
            class={`absolute top-0 right-0 h-5/6 w-1/3 z-10 hover-tooltip ${id}-next-hover opacity-100 pointer-events-auto`}
            data-hover-text="Next"
        >
        </div>
        <div
            id={`${id}-carousel`}
            style={ratio ? `aspect-ratio: ${ratio}` : null}
            class="w-full carousel flex relative overflow-hidden"
        >
            {
                images.map((img) => {
                    return (
                        <div class="carousel-item relative space-mono-regular flex items-center justify-center bg-background snap-center">
                            {img.type === "img" ? (
                                <WebGLImage
                                    class={`${img.fit ? "object-contain h-full" : "object-cover w-full h-full"} pointer-events-none`}
                                    src={img.src}
                                    alt={img.alt}
                                />
                            ) : (
                                <WebGLVideo
                                    class={`${img.fit ? "object-contain h-full" : "object-cover w-full h-full"} pointer-events-none`}
                                    src={img.src}
                                />
                            )}
                        </div>
                    );
                })
            }
        </div>
        <ProjectGalleryControls client:load galleryId={id} images={images} />
    </div>
</div>
